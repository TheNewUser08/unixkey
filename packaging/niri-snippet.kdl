// --- UniXKey Integration for ~/.config/niri/config.kdl ---

// 1. Autostart unixkey-daemon when Niri starts
spawn-at-startup "unixkey-daemon"

// 2. Optional keybind to toggle VN/EN (in addition to UniXKey's built-in Ctrl+Shift)
binds {
    Mod+Space { spawn "unixkey-ctl" "toggle"; }
}

// 3. Open UniXKey Settings GUI as a centered floating window in Niri
window-rule {
    match app-id="^unixkey-gui$"
    open-floating true
    default-column-width { fixed 840; }
    default-window-height { fixed 560; }
}
