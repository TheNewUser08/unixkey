[Unit]
Description=ViKey — Standalone Wayland Vietnamese Input Method Daemon for Niri
Documentation=https://github.com/dang/vikey
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/vikey-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
